package componentized:services-test-components;

world stub-lifecycle {
    include componentized:services/service-lifecycle@0.0.5-dev;
}

world stub-credential-store {
    export componentized:services/credential-store@0.0.5-dev;
    include wasi:logging/imports@0.1.0-draft;
}

world stub-credential-admin {
    export componentized:services/credential-admin@0.0.5-dev;
    include wasi:logging/imports@0.1.0-draft;
}

world stub-client {
    export greeter: interface {
        greet: func(name: string) -> result<string, string>;
    }
    include wasi:config/imports@0.2.0-rc.1;
    include wasi:logging/imports@0.1.0-draft;
}

world cli {
    include componentized:services/imports@0.0.5-dev;

    import ops;

    include componentized:static-config/imports@0.3.0;

    include wasi:random/imports@0.3.0;
    include wasi:cli/command@0.3.0;
}

world lifecycle-router {
    import filesystem-lifecycle: componentized:services/lifecycle@0.0.5-dev;
    import keyvalue-lifecycle: componentized:services/lifecycle@0.0.5-dev;
    import componentized:services/credential-admin@0.0.5-dev;
    import componentized:services/credential-store@0.0.5-dev;

    export componentized:services/lifecycle@0.0.5-dev;
}

world ops-router {
    import filesystem-ops: ops;
    import keyvalue-ops: ops;
    import componentized:secrets/store@0.1.1;

    export ops;
}

world filesystem-ops {
    include wasi:filesystem/imports@0.3.0;

    export ops;
}

world keyvalue-ops {
    include wasmcloud:keyvalue/imports@0.2.0;

    export ops;
}

world filesystem-chroot-config {
    import componentized:secrets/store@0.1.1;
    export wasi:config/store@0.2.0-rc.1;
}
