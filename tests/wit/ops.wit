interface ops {
    use componentized:services/types@0.0.5.{error};

    %list: async func(path: string) -> result<list<string>, error>;
    read: async func(path: string) -> result<list<u8>, error>;
    write: async func(path: string, data: list<u8>) -> result<_, error>;
    move: async func(from-path: string, to-path: string) -> result<_, error>;
    delete: async func(path: string) -> result<_, error>;
}
