package componentized:service-ops;

let credential-store = new local:filesystem-credential-store {
    ...
};
let credential-config = new local:credential-config {
    credential-store: credential-store.credential-store,
    ...
};

let filesystem-client = new local:dep-componentized-filesystem-chroot {
    store: credential-config.store,
    ...
};
let filesystem-ops = new local:test-filesystem-ops {
    "wasi:filesystem/preopens@0.2.12": filesystem-client.preopens,
    "wasi:filesystem/types@0.2.12": filesystem-client.types,
    ...
};

let keyvalue-client = new local:dep-componentized-valkey-valkey-client {
    store: credential-config.store,
    ...
};
let keyvalue-ops = new local:test-keyvalue-ops {
    "wasi:keyvalue/store@0.2.0-draft2": keyvalue-client["wasi:keyvalue/store@0.2.0-draft2"],
    ...
};

let ops = new local:test-ops-router {
    store: credential-config.store,
    filesystem-ops: filesystem-ops.ops,
    keyvalue-ops: keyvalue-ops.ops,
    ...
};

export ops...;
